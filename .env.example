# Copy to .env.local for LOCAL development only (`npm run dev`). Never commit .env / .env.local.
#
# ⚠️ SECURITY: every VITE_* variable is inlined into the PUBLIC JavaScript bundle at build time.
#   Anyone who opens the GitHub Pages site can read it (DevTools > Sources), even if the repo is private.
#
# Gemini API key — DEV ONLY. The production build ignores it (see src/firebase.js getGeminiKey).
# On the deployed site, paste the key in ⚙️ 設定 instead; it is stored only in that browser's localStorage.
VITE_GEMINI_API_KEY=

# Firebase web config (optional). These values are public identifiers by design, NOT secrets;
# protection comes from Firestore Security Rules + Auth authorized domains. You can also paste the
# config in ⚙️ 設定 instead of baking it into the build.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
