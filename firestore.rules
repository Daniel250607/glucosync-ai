rules_version = '2';

// Firestore Security Rules for GlucoSync. This file is the reference copy: paste it into
// Firebase Console > Firestore Database > Rules and publish (it is not deployed automatically).
// The ALLOWED_EMAIL check in src/firebase.js is client-side only; these rules are the real protection.
service cloud.firestore {
  match /databases/{database}/documents {

    // 本人帳號：email 相符、信箱已驗證、且透過 Google 登入
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == "daniel.chang.hy@gmail.com"
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == "google.com";
    }

    // 每日飲食、飲水、運動、用藥紀錄（含刪除後的 tombstone）
    match /days/{dayId} {
      allow read, write: if isOwner();
    }

    // 檢驗報告
    match /labs/{labId} {
      allow read, write: if isOwner();
    }

    // 個人自訂設定（config/custom）與一次性 QR 配對文件（config/qr_pairing_*）
    match /config/{configId} {
      allow read, write: if isOwner();
    }

    // 其餘路徑：Firestore 預設全部拒絕，不需要另寫規則
  }
}
